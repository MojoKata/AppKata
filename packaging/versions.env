# The Python and PySide6 every release carries, and the ones development and the tests run AppKata
# on (requirement 1.2): one setting for the AppImage, the Windows installer and the tests. Sourced by
# scripts/build-appimage.sh, scripts/build-windows.sh, scripts/test-windows-vm.sh,
# scripts/python-standalone.sh and scripts/test-sandbox.sh; the environment can override either, to try another.
: "${PY_SERIES:=3.14}"
# Qt 6.12 (LTS) is Qt's last version for Windows 10, AppKata's 22H2 target (requirement 1.1):
# https://doc.qt.io/qt-6.12/windows.html. Check Windows 10 is still supported before moving past it.
: "${PYSIDE:=6.11.2}"
# The CPython the release carries: python-build-standalone's build <version>+<release>, and the
# SHA-256 of its x86_64 Linux tarball. PY_SERIES is its series; another series, to try one, comes
# from the same release, checked only against that release's SHA256SUMS.
PYTHON_BUILD=3.14.8+20261013
PYTHON_LINUX_SHA256=d8faa1b588506b9e3e5a3f57807bb056d534a1641a6b10d15b6ea3f0b413b960

# Everything else the builds and CI take from outside, pinned (the CI walk thru, item 7): each
# changes only by a commit here, and tests/test_pinned_inputs.py fails on an input named by a tag
# or a release that moves. Docker goes by an image's digest; its tag only says what it is.
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
# the runtime appimagetool puts at the front of the AppImage (without one it downloads the newest)
APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
JAMMY_IMAGE=ubuntu:22.04@sha256:b8b6ee6aa931ecd9d0d952abc34dc0e5f7c6a30c6bb71b079fe399fde0329c02      # builds the AppImage (glibc 2.35)
NOBLE_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3      # tier 1
MINGW_IMAGE=debian:12@sha256:854dd8ab51d62866dbd8f5431d15ce77b12983a2a4a1e1fe43a2395dc7ef9f61         # compiles the icuuc.dll stand-in
PYWINE_IMAGE=tobix/pywine:3.14@sha256:b053219cba558a12a8a3df2401a653b2ab2fced6833accd1e5d72399d7da1ad3 # PyInstaller under Wine, on PYTHON_BUILD's version
INNOSETUP_IMAGE=amake/innosetup@sha256:e003376ba818547275fe10c95e2a29be0f2d12d45e9eb8f205b6672dc5685bb1 # Inno Setup 6 under Wine (2026-02-23)
