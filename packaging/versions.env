# The Python and PySide6 every release carries, and the ones development and the tests run AppKata
# on (requirement 1.2): one setting for the AppImage, the Windows installer and the tests. Sourced by
# scripts/build-appimage.sh, scripts/build-windows.sh, scripts/test-windows-vm.sh,
# scripts/python-standalone.sh and scripts/test-sandbox.sh; the environment can override either.
: "${PY_SERIES:=3.14}"
# Qt 6.12 (LTS) is Qt's last version for Windows 10, AppKata's 22H2 target (requirement 1.1):
# https://doc.qt.io/qt-6.12/windows.html. Check Windows 10 is still supported before moving past it.
: "${PYSIDE:=6.11.2}"
