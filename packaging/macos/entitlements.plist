<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for AppKata's executables (mac-sign.sh).
  - allow-jit: Qt's QML engine JIT-compiles JavaScript; without it QML falls back to the
    slower interpreter.
  - allow-unsigned-executable-memory: Python's ctypes/libffi callbacks need writable and
    executable memory on older libffi builds.
  Library validation stays on: every library in the bundle is signed with our identity.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
